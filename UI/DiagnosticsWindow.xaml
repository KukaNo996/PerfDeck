<Window x:Class="PerfDeck.UI.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="传感器诊断" Width="660" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Microsoft YaHei UI, Segoe UI">

    <Border CornerRadius="14" Background="#0A0E13" BorderBrush="#1E2733" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,13,12,8" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="已识别的硬件传感器" Foreground="#E9F1FA" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource IconBtn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <TextBox x:Name="TxtDump" Grid.Row="1" Margin="18,0,18,18" IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5" Background="#0C1218"
                     Foreground="#A9BBCD" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Grid>
    </Border>
</Window>
